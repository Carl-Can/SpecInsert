# Base URL of the Bio-House API. No trailing slash.
# Used by Vite as import.meta.env.VITE_API_BASE_URL.
# Leave the localhost value for ./start.sh.
# Set this to the deployed API origin before `npm run build` if the
# frontend is hosted separately. Do not put secrets in this file.
VITE_API_BASE_URL=http://localhost:8000
