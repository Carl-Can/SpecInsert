# Copy this file to backend/.env and set a real key.
# backend/.env is gitignored. Never commit a real key.
# OpenAI-compatible APIs work (DeepSeek, Qwen, OpenAI, or a local server).
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# Comma-separated browser origins allowed to call this API.
# Defaults inside the server cover http://localhost:5173, http://127.0.0.1:5173,
# and http://localhost:3000 when this variable is unset.
# For a public demo, set the real frontend origin. Use * only if the demo
# does not send cookies (credentials are disabled for a wildcard).
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example

# Local OpenAI-compatible server example:
# LLM_BASE_URL=http://127.0.0.1:8001/v1
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
