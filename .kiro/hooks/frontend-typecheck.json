{
  "version": "v1",
  "hooks": [
    {
      "name": "前端 TypeScript 类型检查",
      "trigger": "PostFileSave",
      "description": "保存 frontend/src 下的 TS/TSX 后运行 tsc。命令从仓库根目录运行，路径相对仓库根，不依赖某台机器的绝对路径。",
      "matcher": "frontend/src/.*\\.(ts|tsx)$",
      "action": {
        "type": "command",
        "command": "cd frontend && npx tsc --noEmit -p tsconfig.app.json",
        "timeout": 60
      }
    }
  ]
}
